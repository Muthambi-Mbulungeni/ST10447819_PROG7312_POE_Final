<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartX.Desktop.ViewModels"
             xmlns:ctrl="using:SmartX.Desktop.Controls"
             x:Class="SmartX.Desktop.Views.CommandStreamView"
             x:DataType="vm:CommandStreamViewModel"
             x:Name="RootView"
             Background="#0f0f1a">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══════════════════════════════════════════════════════════
             HEADER BAR — Queue depths + alert count + simulation
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Real-Time Command Stream &amp; Processing Engine" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8B92A9" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Simulate Critical Alert Button -->
                <Button Grid.Column="1" Command="{Binding SimulateCriticalAlertCommand}"
                        Background="#991b1b" Foreground="White" CornerRadius="8" Padding="12,6" Margin="0,0,10,0"
                        ToolTip.Tip="Immediately enqueues a critical power spike into the PriorityQueue">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#fca5a5"/>
                        <TextBlock Text="Simulate Spike" FontWeight="Bold" FontSize="11" Foreground="#fca5a5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Critical Queue depth (PriorityQueue) -->
                <Border Grid.Column="2" Background="#7f1d1d" CornerRadius="8" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalQueueDepth}" FontSize="18" FontWeight="Bold" Foreground="#fca5a5" HorizontalAlignment="Center"/>
                        <TextBlock Text="PRIORITY QUEUE" FontSize="9" Foreground="#fca5a5" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Standard Queue depth -->
                <Border Grid.Column="3" Background="#1e3a5f" CornerRadius="8" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding StandardQueueDepth}" FontSize="18" FontWeight="Bold" Foreground="#93c5fd" HorizontalAlignment="Center"/>
                        <TextBlock Text="FIFO QUEUE" FontSize="9" Foreground="#93c5fd" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Active alerts (HashSet count) -->
                <Border Grid.Column="4" Background="#422006" CornerRadius="8" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveAlertCount}" FontSize="18" FontWeight="Bold" Foreground="#fdba74" HorizontalAlignment="Center"/>
                        <TextBlock Text="HASHSET ALERTS" FontSize="9" Foreground="#fdba74" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Command history depth (Stack) -->
                <Border Grid.Column="5" Background="#1a2e1a" CornerRadius="8" Padding="14,6">
                    <StackPanel>
                        <TextBlock Text="{Binding CommandHistory.Count}" FontSize="18" FontWeight="Bold" Foreground="#86efac" HorizontalAlignment="Center"/>
                        <TextBlock Text="STACK HISTORY" FontSize="9" Foreground="#86efac" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT — three-column layout
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*,330" Margin="12">

            <!-- ─────────────────────────────────────────────────────
                 LEFT PANEL — Live packet feed (Queue + PriorityQueue)
                 ───────────────────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,160,Auto,*" Margin="0,0,8,0">

                <!-- Critical alerts (PriorityQueue) -->
                <TextBlock Grid.Row="0" Text="⚡ PriorityQueue (Critical Alerts)" FontSize="13" FontWeight="Bold"
                           Foreground="#fca5a5" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Background="#1c0a0a" CornerRadius="8" Padding="6" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CriticalPackets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3d1515" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding NodeId}" FontWeight="Bold" Foreground="#fca5a5" FontSize="11"/>
                                                <TextBlock Text="{Binding DeviceId}" Foreground="#f87171" FontSize="9"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#ef4444" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F1}'}"
                                                       Foreground="#fca5a5" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Standard queue (FIFO Queue<T>) -->
                <TextBlock Grid.Row="2" Text="📥 FIFO Message Queue (Standard)" FontSize="13" FontWeight="Bold"
                           Foreground="#93c5fd" Margin="0,0,0,6"/>

                <Border Grid.Row="3" Background="#0a1225" CornerRadius="8" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StandardPackets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0f1e3a" CornerRadius="6" Padding="6" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding NodeId}" Foreground="#93c5fd" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#60a5fa" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F1}'}"
                                                       Foreground="White" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ─────────────────────────────────────────────────────
                 MIDDLE PANEL — Devices (Dictionary) + Timeline Graph (SortedDictionary) + Command form
                 ───────────────────────────────────────────────────── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="0,0,8,0">

                <!-- Search / Filter bar -->
                <Border Grid.Row="0" Background="#1a1a2e" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding FilterCategory}"
                                 Watermark="Search category, node ID, or MAC (e.g. PowerConsumption, NODE-Zone-A)…"
                                 Background="#252542" Foreground="White"
                                 CornerRadius="6" Padding="8,6" Margin="0,0,8,0"/>
                        <CheckBox Grid.Column="1" Content="Anomaly Only" IsChecked="{Binding ShowAnomalyOnly}"
                                  Foreground="#fdba74" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="🔍 Search" Command="{Binding ApplyFilterCommand}"
                                Background="#3b82f6" Foreground="White" CornerRadius="6" Padding="10,6" Margin="0,0,6,0"/>
                        <Button Grid.Column="3" Content="✕ Clear" Command="{Binding ClearFilterCommand}"
                                Background="#374151" Foreground="White" CornerRadius="6" Padding="10,6"/>
                    </Grid>
                </Border>

                <!-- Device Directory (Dictionary O(1) Lookups) -->
                <Border Grid.Row="1" Background="#111827" CornerRadius="8" Padding="6" Margin="0,0,0,8">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="8,4,8,8">
                            <TextBlock Grid.Column="0" Text="Node &amp; MAC (Dictionary O(1))" FontSize="11" FontWeight="Bold" Foreground="#8B92A9"/>
                            <TextBlock Grid.Column="1" Text="Category" FontSize="11" FontWeight="Bold" Foreground="#8B92A9" Width="120"/>
                            <TextBlock Grid.Column="2" Text="Value"    FontSize="11" FontWeight="Bold" Foreground="#8B92A9" Width="60"/>
                            <TextBlock Grid.Column="3" Text="Unit"     FontSize="11" FontWeight="Bold" Foreground="#8B92A9" Width="45"/>
                            <TextBlock Grid.Column="4" Text="Status"   FontSize="11" FontWeight="Bold" Foreground="#8B92A9" Width="70"/>
                            <TextBlock Grid.Column="5" Text="Action"   FontSize="11" FontWeight="Bold" Foreground="#8B92A9" Width="55"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" Margin="0,1" CornerRadius="4" Background="#161e2e">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding NodeId}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Mac}" Foreground="#6b7280" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#a78bfa" FontSize="11" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LastValue, StringFormat='{}{0:F1}'}" Foreground="White" FontSize="12" FontWeight="Bold" Width="60" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="#9ca3af" FontSize="10" Width="45" VerticalAlignment="Center"/>
                                                
                                                <Border Grid.Column="4" Width="65" CornerRadius="4" Padding="4,2" VerticalAlignment="Center"
                                                        Background="{Binding IsAnomaly, Converter={StaticResource AnomalyColorConverter}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>

                                                <Button Grid.Column="5" Content="Select" FontSize="10" Width="50"
                                                        Command="{Binding ((vm:CommandStreamViewModel)DataContext).SelectDeviceCommand, ElementName=RootView}"
                                                        CommandParameter="{Binding}"
                                                        Background="#374151" Foreground="#93c5fd" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- SortedDictionary Chronological Timeline Graph -->
                <Border Grid.Row="2" Background="#151b2d" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid RowDefinitions="Auto,60,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="📈 Chronological Timeline (SortedDictionary)" FontSize="12" FontWeight="Bold" Foreground="#93c5fd"/>
                            <TextBlock Grid.Column="1" Text="Sequential by Timestamp" FontSize="10" Foreground="#64748b"/>
                        </Grid>

                        <!-- Live Timeline Sparkline via MiniGraph -->
                        <ctrl:MiniGraph Grid.Row="1" History="{Binding TimelineSparkline}" LineBrush="#38bdf8" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Text="{Binding Timeline.Count, StringFormat='Buffered {0} chronologically ordered historical records'}"
                                   FontSize="10" Foreground="#94a3b8"/>
                    </Grid>
                </Border>

                <!-- ── Issue Manual Override Command (Stack<T> push & pop) ── -->
                <Border Grid.Row="3" Background="#1a1a2e" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="⚙ Issue Manual Override Command (Stack LIFO History)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Undo restores previous state" FontSize="10" Foreground="#94a3b8"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0" Text="{Binding TargetDeviceId}"
                                     Watermark="Target Device ID / MAC…"
                                     Background="#252542" Foreground="White" CornerRadius="6" Padding="8,6" Margin="0,0,6,0"/>
                            
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableCommandTypes}"
                                      SelectedItem="{Binding CommandType}"
                                      Background="#252542" Foreground="White" CornerRadius="6"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>

                        <TextBox Text="{Binding CommandPayload}"
                                 Watermark="Payload / parameter (e.g. TOGGLE_PUMP, THRESHOLD=85)…"
                                 Background="#252542" Foreground="White" CornerRadius="6" Padding="8,6"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0" Content="▶ Send Command (Push to Stack)" Command="{Binding SendCommandCommand}"
                                    Background="#10b981" Foreground="White" CornerRadius="6" Padding="12,8" Margin="0,0,8,0"
                                    HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="↩ Undo Last (Pop from Stack)" Command="{Binding UndoCommandCommand}"
                                    Background="#f59e0b" Foreground="White" CornerRadius="6" Padding="12,8"/>
                        </Grid>

                        <TextBlock Text="{Binding UndoResult}" Foreground="#86efac" FontSize="11"
                                   IsVisible="{Binding UndoResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─────────────────────────────────────────────────────
                 RIGHT PANEL — Stack history + HashSet alerts + Predictions
                 ───────────────────────────────────────────────────── -->
            <Grid Grid.Column="2" RowDefinitions="Auto,150,Auto,130,Auto,*">

                <!-- Command history (Stack LIFO) -->
                <TextBlock Grid.Row="0" Text="📋 Command History (Stack LIFO Undo)" FontSize="13"
                           FontWeight="Bold" Foreground="#86efac" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="#0d1f12" CornerRadius="8" Padding="6" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommandHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#162a1c" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Type}" Foreground="#86efac" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="#4b5563" FontSize="10"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DeviceId}" Foreground="#d1fae5" FontSize="10"/>
                                            <TextBlock Text="{Binding IssuedAt}" Foreground="#6b7280" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Active Alerts (HashSet<T>) -->
                <TextBlock Grid.Row="2" Text="🚨 Active Alerts (HashSet — Deduplicated)" FontSize="13"
                           FontWeight="Bold" Foreground="#fdba74" Margin="0,0,0,6"/>
                <Border Grid.Row="3" Background="#1c1004" CornerRadius="8" Padding="6" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2d1a06" CornerRadius="6" Padding="6" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#fdba74"
                                                       FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button Grid.Column="1" Content="Resolve" FontSize="10"
                                                    Command="{Binding ((vm:CommandStreamViewModel)DataContext).ResolveAlertCommand, ElementName=RootView}"
                                                    CommandParameter="{Binding}"
                                                    Background="#15803d" Foreground="White" CornerRadius="4" Padding="6,2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Predictive Insights & Automated Suggestions -->
                <TextBlock Grid.Row="4" Text="🤖 Automated Insights &amp; Suggestions" FontSize="13"
                           FontWeight="Bold" Foreground="#c4b5fd" Margin="0,0,0,6"/>
                <Border Grid.Row="5" Background="#130f1f" CornerRadius="8" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Predictions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8" Margin="0,0,0,6" Background="#1e1533">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold"
                                                           Foreground="#c4b5fd" FontSize="11" TextWrapping="Wrap"/>
                                                <Button Grid.Column="1" Content="Target" FontSize="9"
                                                        Command="{Binding ((vm:CommandStreamViewModel)DataContext).ApplyRecommendationCommand, ElementName=RootView}"
                                                        CommandParameter="{Binding}"
                                                        Background="#6d28d9" Foreground="White" CornerRadius="4" Padding="5,1"/>
                                            </Grid>
                                            <Border Background="#7c3aed" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding InsightType}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}" Foreground="#e9d5ff" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
