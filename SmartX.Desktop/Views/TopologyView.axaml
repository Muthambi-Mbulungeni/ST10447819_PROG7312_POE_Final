<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartX.Desktop.ViewModels"
             x:Class="SmartX.Desktop.Views.TopologyView"
             x:DataType="vm:TopologyViewModel"
             Background="#1a1a2e">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="Deployment Topology Validation" FontSize="24" FontWeight="Bold" Foreground="White" />
        
        <Button Content="Validate Network Deployment" 
                Command="{Binding ValidateTopologyCommand}" 
                Background="#3b82f6" Foreground="White" 
                Padding="15,10" CornerRadius="5"/>
        
        <Border Background="#252542" CornerRadius="8" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="16" />
                
                <ItemsControl ItemsSource="{Binding BrokenPaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#ef4444" Margin="0,5" FontFamily="Consolas, Monospace" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
