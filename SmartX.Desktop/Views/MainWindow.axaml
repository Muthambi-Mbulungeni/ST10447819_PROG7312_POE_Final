<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartX.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SmartX.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Smart-X Mesh Desktop"
        Background="#0f0f1a"
        Width="1280" Height="800">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             TOP NAVIGATION BAR
             ════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⬡" Foreground="#7c3aed" FontSize="24"/>
                    <TextBlock Text="Smart-X Mesh" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">

                    <!-- Pillar 1 — Sensor Data Ingestion & Telemetry -->
                    <Button Command="{Binding NavigateToHeatmapCommand}"
                            Background="{Binding IsHeatmapActive, Converter={StaticResource NavColorConverter}}"
                            Foreground="White" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📡" FontSize="14"/>
                            <StackPanel>
                                <TextBlock Text="Sensor Data Ingestion" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Pillar 1 — Ingestion &amp; Heatmap" FontSize="9" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="#374151" Margin="4,4"/>

                    <!-- Pillar 2 — Real Time Command Stream -->
                    <Button Command="{Binding NavigateToCommandStreamCommand}"
                            Background="{Binding IsCommandStreamActive, Converter={StaticResource NavColorConverter}}"
                            Foreground="White" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚡" FontSize="14"/>
                            <StackPanel>
                                <TextBlock Text="Real Time Command Stream" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Pillar 2 — Queue · Stack · Alerts" FontSize="9" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="#374151" Margin="4,4"/>

                    <!-- Pillar 3 — Network Topology & Mesh Routing -->
                    <Button Command="{Binding NavigateToTopologyCommand}"
                            Background="{Binding IsTopologyActive, Converter={StaticResource NavColorConverter}}"
                            Foreground="White" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🕸" FontSize="14"/>
                            <StackPanel>
                                <TextBlock Text="Network Topology &amp; Mesh Routing" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Pillar 3 — Graph · MST · AVL Tree" FontSize="9" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="#374151" Margin="4,4"/>

                    <!-- Registry -->
                    <Button Command="{Binding NavigateToRegistryCommand}"
                            Background="{Binding IsRegistryActive, Converter={StaticResource NavColorConverter}}"
                            Foreground="White" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🗂" FontSize="14"/>
                            <StackPanel>
                                <TextBlock Text="Sensor Registry" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Device Management &amp; Firmware" FontSize="9" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- API status indicator -->
                <Border Grid.Column="2" Background="#0f2a0f" CornerRadius="6" Padding="10,6">
                    <TextBlock Text="● API Connected" Foreground="#4ade80" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             MAIN CONTENT AREA (seamless navigation)
             ════════════════════════════════════════ -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
